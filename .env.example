# ─────────────────────────────────────────────────────────────
# Пример переменных окружения. Скопируй в .env и заполни значения:
#   cp .env.example .env
# Файл .env в .gitignore и в репозиторий не попадает.
# На Vercel эти переменные задаются в Project → Settings → Environment Variables
# (переменные базы Neon прописываются автоматически при подключении Storage).
# ─────────────────────────────────────────────────────────────

# ── База данных (Neon / PostgreSQL) — ОБЯЗАТЕЛЬНО ──
# POSTGRES_URL         — пул соединений (pooler), используется приложением в рантайме
# POSTGRES_URL_NON_POOLING — прямое подключение, нужно для миграций / prisma db push
POSTGRES_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── NextAuth (авторизация) — ОБЯЗАТЕЛЬНО для входа ──
# Сгенерировать секрет: openssl rand -base64 32
NEXTAUTH_SECRET="сгенерируй-длинную-случайную-строку"
# Локально — адрес dev-сервера; на Vercel подставь домен проекта
NEXTAUTH_URL="http://localhost:3000"

# ── Базовый URL для клиентских запросов к API (axios) — ОБЯЗАТЕЛЬНО ──
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ─────────────────────────────────────────────────────────────
# Ниже — наследие шаблона dodo. НЕ обязательны для запуска первой страницы,
# будут пересмотрены/удалены при переходе на приложение для официантов.
# ─────────────────────────────────────────────────────────────

# Вход через GitHub OAuth (опционально)
GITHUB_ID=""
GITHUB_SECRET=""

# Автоподсказки адресов DaData (опционально, legacy — доставка)
NEXT_PUBLIC_DADATA_TOKEN=""

# Отправка писем через Resend (опционально, legacy — подтверждение заказа)
RESEND_API_KEY=""

# Платежи ЮKassa (опционально, legacy — оплата заказа)
YOOKASSA_STORE_ID=""
YOOKASSA_API_KEY=""
YOOKASSA_CALLBACK_URL=""
