generator client {
	provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  // directUrl = env("DIRECT_URL")
}

enum UserRole {
	ADMIN
	WAITER
}

model User {
	id Int @id @default(autoincrement())

	fullName String
	email String @unique
	password String
	role UserRole @default(WAITER)

	createdAt DateTime @default(now())
	updatedAt DateTime @default(now()) @updatedAt
}

model Category {
	id Int @id @default(autoincrement())

	name String

	dishes Dish[]
}

model Dish {
	id Int @id @default(autoincrement())

	name String
	description String?
	imageUrl String

	price Int // копейки
	weight Int // граммы

	isPublished Boolean @default(false)

	category Category @relation(fields: [categoryId], references: [id])
	categoryId Int

	ingredients Ingredient[]
	allergens Allergen[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model Ingredient {
	id Int @id @default(autoincrement())

	name String
	imageUrl String

	dishes Dish[]
}

model Allergen {
	id Int @id @default(autoincrement())

	name String

	dishes Dish[]
}
